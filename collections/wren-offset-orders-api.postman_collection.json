    {
      "id": "e16df913-3664-45e5-a0ef-c2aa5ee35e43",
      "name": "Offset Orders",
      "description": {
        "content": "Create and list carbon offset orders by tonnage",
        "type": "text/plain"
      },
      "item": [
        {
          "id": "03f61388-eea7-4ad1-ae7f-3aa90c144f63",
          "name": "Create offset orders",
          "request": {
            "name": "Create offset orders",
            "description": {
              "content": "Creates offset orders by allocating a given number of tons across the projects in a portfolio. Funds are distributed according to the portfolio's allocation percentages. Test tokens (wren_test_...) return canned responses with \"test\":true and test_oo_ prefixed IDs without charges or side effects.",
              "type": "text/plain"
            },
            "url": {
              "path": [
                "api",
                "offset-orders"
              ],
              "host": [
                "{{baseUrl}}"
              ],
              "query": [],
              "variable": []
            },
            "header": [
              {
                "key": "Content-Type",
                "value": "application/x-www-form-urlencoded"
              },
              {
                "key": "Accept",
                "value": "application/json"
              }
            ],
            "method": "POST",
            "auth": null,
            "body": {
              "mode": "urlencoded",
              "urlencoded": [
                {
                  "disabled": false,
                  "key": "tons",
                  "value": "<number>",
                  "description": "(Required) Amount of CO2e to offset in tonnes. Must be positive."
                },
                {
                  "disabled": false,
                  "key": "portfolioId",
                  "value": "<number>",
                  "description": "Portfolio ID for allocation. Default: Wren Climate Fund."
                },
                {
                  "disabled": false,
                  "key": "note",
                  "value": "<string>",
                  "description": "Note attached to each order."
                },
                {
                  "disabled": false,
                  "key": "dryRun",
                  "value": "<boolean>",
                  "description": "If true, no charge is made; returns preview only."
                },
                {
                  "disabled": false,
                  "key": "sendReceiptEmail",
                  "value": "<boolean>",
                  "description": "If true, sends a receipt email when dryRun is false."
                },
                {
                  "disabled": false,
                  "key": "paymentMethod",
                  "value": "stripe",
                  "description": "When credits, deducts from the credit balance instead of charging Stripe. No $1 minimum when using credits."
                },
                {
                  "disabled": false,
                  "key": "onBehalfOfName",
                  "value": "<string>",
                  "description": "Name of the end customer shown as purchaser on the impact certificate."
                },
                {
                  "disabled": false,
                  "key": "onBehalfOfEmail",
                  "value": "<string>",
                  "description": "Email of the end customer, stored alongside the order."
                }
              ]
            }
          },
